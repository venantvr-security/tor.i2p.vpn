# Artefacts locaux : ils seraient reconstruits dans l'image de toute façon.
target/
web/node_modules/
web/dist/

# Données et configuration locales : jamais dans une image.
data/
config.toml
config.toml.tmp

# Historique, documentation et outillage : rien de tout cela n'entre dans l'image.
.git/
.github/
.gitignore
docs/
*.md
.idea/
.vscode/
